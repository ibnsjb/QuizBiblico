# Firebase Configuration
# Crie um projeto no Firebase Console (https://console.firebase.google.com)
# e preencha as variáveis abaixo com as credenciais do seu projeto.

NEXT_PUBLIC_FIREBASE_API_KEY=sua-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Banco de dados (Prisma / Postgres)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?schema=public

# Autenticação NextAuth
NEXTAUTH_SECRET=troque-por-um-segredo-forte
NEXTAUTH_URL=https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app
